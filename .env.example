# SmartCharge Grid - Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials.
# Note: If these keys are not set, the application will automatically run in Demo Simulation Mode with local data.

# FastAPI backend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
