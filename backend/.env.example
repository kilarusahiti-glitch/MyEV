# Optional Firestore persistence for meaningful sessions, events, and snapshots.
# Leave disabled for the default in-memory hackathon mode.
# Set true only after installing firebase-admin and configuring a service account
FIREBASE_PERSISTENCE_ENABLED=false
GOOGLE_CLOUD_PROJECT=
# Absolute local path; keep the JSON file outside the repository
GOOGLE_APPLICATION_CREDENTIALS=

# FastAPI CORS
CORS_ALLOW_ORIGINS=http://localhost:5173
